    <element xsi:type="archimate:Goal" name="Ensure effective, equitable and sustainable health financing and public financial management receive reliable digital tools to support intermediate UHC objectives (equitable distribution of resources, efficiency, transparency) and final UHC goals (access in line with need, financial protection, quality of care)" id="id-f5e881e907714bedb922a6697059c8d0"/>
    <element xsi:type="archimate:Goal" name="Utilize digital solutions to streamline health financing functions (revenue raising, pooling and purchasing) as well as accompanying/adjacent sub-functions " id="id-06ccbfe959ef41e6a784904bd86f55c5"/>
    <element xsi:type="archimate:Goal" name="Budget planning, execution and oversight (monitoring): Ensure efficient, transparent health budgets with timely provider payments." id="id-c17c1aa0136b45a48e84904729ac0c42"/>
    <element xsi:type="archimate:Goal" name="Revenue raising for public financial management (e.g., taxes, insurance contributions): Secure sustainable, equitable health sector funds." id="id-6ed9f3f581b04aaa840c4cbfec830b20"/>
    <element xsi:type="archimate:Goal" name="Pooling of funds: Allocate pooled funds equitably across programs, regions, populations." id="id-d8d0e95a40fa41fd9c2921d20f7b2e35"/>
